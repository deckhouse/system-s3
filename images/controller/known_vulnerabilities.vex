{
  "@context": "https://openvex.dev/ns/v0.2.0",
  "@id": "https://openvex.dev/docs/public/vex-system-s3-controller",
  "author": "Deckhouse <contact@deckhouse.io>",
  "version": 4,
  "statements": [
    {
      "vulnerability": {
        "name": "GO-2026-5932"
      },
      "products": [
        {
          "@id": "pkg:golang/golang.org/x/crypto@v0.57.0"
        }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_not_in_execute_path",
      "impact_statement": "Advisory covers the unmaintained golang.org/x/crypto/openpgp subpackage, which no release of golang.org/x/crypto drops, so the finding cannot be resolved by upgrading (v0.57.0, the version this module ships now, still carries it). In the system-s3 controller binary golang.org/x/crypto is pulled in transitively only for key derivation used by the S3 client (internal/backend/s3util -> github.com/minio/minio-go/v7 -> github.com/minio/minio-go/v7/pkg/encrypt -> golang.org/x/crypto/argon2); `go mod why golang.org/x/crypto/openpgp` reports that the main module does not need the openpgp package, so it is not compiled into the binary and the vulnerable code is not in the execution path."
    }
  ],
  "timestamp": "2026-10-23T00:00:00Z"
}
