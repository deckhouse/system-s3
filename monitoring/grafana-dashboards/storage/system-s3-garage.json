  "panels": [
    {
      "type": "row",
      "title": "Cluster",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Cluster available",
      "description": "cluster_available: some node of the plane has a write quorum for every partition. Zero means reads and writes fail; for one minute it is D8SystemS3GarageClusterUnavailable.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$ds_prometheus"
      },
      "targets": [
        {
          "expr": "max(cluster_available{job=\"system-s3-garage\", store=~\"$store\", incarnation=~\"$incarnation\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "All nodes connected",
      "description": "cluster_healthy as the worst node sees it: every storage node connected. Zero while the cluster is available is lost redundancy, D8SystemS3GarageClusterDegraded after five minutes.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$ds_prometheus"
      },
      "targets": [
        {
          "expr": "min(cluster_healthy{job=\"system-s3-garage\", store=~\"$store\", incarnation=~\"$incarnation\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Storage nodes connected",
      "description": "cluster_storage_nodes_ok out of cluster_storage_nodes, as the worst node sees it.",
