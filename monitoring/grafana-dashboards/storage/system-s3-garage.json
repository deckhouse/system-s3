      "targets": [
        {
          "expr": "min(cluster_storage_nodes_ok{job=\"system-s3-garage\", store=~\"$store\", incarnation=~\"$incarnation\"}) / max(cluster_storage_nodes{job=\"system-s3-garage\", store=~\"$store\", incarnation=~\"$incarnation\"})",
