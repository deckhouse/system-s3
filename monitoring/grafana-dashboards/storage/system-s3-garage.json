    {
      "type": "timeseries",
      "title": "Layout nodes connected, by observing pod",
      "description": "cluster_layout_node_connected summed per observing pod: how many layout nodes each pod reaches. A pod that sees fewer than the others is the one cut off.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$ds_prometheus"
      },
      "targets": [
        {
          "expr": "sum by (pod) (cluster_layout_node_connected{job=\"system-s3-garage\", store=~\"$store\", incarnation=~\"$incarnation\"})",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Seconds since a node was last seen",
      "description": "cluster_layout_node_disconnected_time per Garage node ID, worst observer. Zero while connected; above 300 for five minutes is D8SystemS3GarageNodeDisconnected. `garage status` maps the ID to the pod.",
      "gridPos": {
        "h": 8,
