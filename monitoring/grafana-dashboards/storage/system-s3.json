{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "Store",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Store is serving",
      "description": "system_s3_store_ready: the data plane is up and answering S3. Zero for ten minutes is D8SystemS3StoreNotReady, and for as long as it lasts no consumer can read or write.",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$ds_prometheus"
      },
      "targets": [
        {
          "expr": "min(system_s3_store_ready)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Capacity in the layout",
      "description": "system_s3_store_capacity_bytes: what Garage accepted into its layout. It differs from the volume size when a replica never made it into the layout.",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 5,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$ds_prometheus"
      },
      "targets": [
        {
          "expr": "max(system_s3_store_capacity_bytes)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Volume short of what is asked",
      "description": "The gap between the size one replica's volume should have, from the sum of the SystemBucket sizes, and the size it has. Above zero for half an hour is D8SystemS3StoreCannotGrow: until then, a bucket that fills up simply stops accepting writes.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 10,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$ds_prometheus"
      },
      "targets": [
        {
          "expr": "max(system_s3_store_volume_desired_bytes - system_s3_store_volume_capacity_bytes)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Buckets not ready",
      "description": "SystemBuckets that have not reached Ready. These are the consumers with no working storage, and nothing else in the cluster reports it.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$ds_prometheus"
      },
      "targets": [
        {
          "expr": "count(system_s3_bucket_ready == 0) or vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Credential refusals in the last hour",
      "description": "How often the endpoint refused to issue temporary credentials. AccessDenied among them is RBAC working as intended; LimitExceeded means a client is asking on every request and has hit the ceiling of 50 unexpired keys per bucket.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$ds_prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(system_s3_sts_requests_total{result!=\"Granted\"}[1h])) or vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "type": "timeseries",
      "title": "One replica's volume: desired, requested, actual",
      "description": "Three sizes of one volume. They are equal on a healthy store. Desired above requested means the claims could not even be patched — a StorageClass without allowVolumeExpansion. Requested above capacity means the claims were patched and the CSI driver has not finished.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$ds_prometheus"
      },
      "targets": [
        {
          "expr": "max(system_s3_store_volume_desired_bytes)",
          "legendFormat": "desired (sum of the bucket sizes)",
          "refId": "A"
        },
        {
          "expr": "min(system_s3_store_volume_requested_bytes)",
          "legendFormat": "requested (claim)",
          "refId": "B"
        },
        {
          "expr": "min(system_s3_store_volume_capacity_bytes)",
          "legendFormat": "actual (volume)",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "How full the store is",
      "description": "What the buckets hold against what they are allowed to hold, and how much room a volume has. The sum of the quotas is what the volume size is computed from.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$ds_prometheus"
      },
      "targets": [
        {
          "expr": "sum(system_s3_bucket_used_bytes)",
          "legendFormat": "used across all buckets",
          "refId": "A"
        },
        {
          "expr": "sum(system_s3_bucket_quota_bytes)",
          "legendFormat": "sum of the quotas",
          "refId": "B"
        },
        {
          "expr": "min(system_s3_store_volume_capacity_bytes)",
          "legendFormat": "one replica's volume",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "row",
      "title": "Consumers' buckets",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Bucket fill against its quota",
      "description": "The share of its quota a bucket has taken. At 80 % D8SystemS3BucketAlmostFull fires; at 100 % the bucket refuses writes — the only warning a platform component gets.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$ds_prometheus"
      },
      "targets": [
        {
          "expr": "100 * system_s3_bucket_used_bytes / (system_s3_bucket_quota_bytes > 0)",
          "legendFormat": "{{namespace}}/{{name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "table",
      "title": "Buckets",
      "description": "One row per SystemBucket: whether it is ready, what it holds, what it is allowed to hold. A row with ready=0 is a consumer with no working storage.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$ds_prometheus"
      },
      "targets": [
        {
          "expr": "system_s3_bucket_ready",
          "legendFormat": "ready",
          "refId": "A",
          "format": "table",
          "instant": true
        },
        {
          "expr": "system_s3_bucket_used_bytes",
          "legendFormat": "used",
          "refId": "B",
          "format": "table",
          "instant": true
        },
        {
          "expr": "system_s3_bucket_quota_bytes",
          "legendFormat": "quota",
          "refId": "C",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true,
              "instance": true,
              "container": true,
              "endpoint": true,
              "pod": true,
              "service": true,
              "prometheus": true,
              "prometheus_replica": true
            }
          }
        }
      ]
    },
    {
      "type": "row",
      "title": "Access",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Temporary credentials by outcome",
      "description": "What the token-exchange endpoint answered. Granted is a key issued; AccessDenied is a subject without a grant on that bucket, which is RBAC working rather than a fault; LimitExceeded is a bucket at its ceiling of 50 unexpired keys, i.e. a client asking for credentials on every request instead of holding one.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$ds_prometheus"
      },
      "targets": [
        {
          "expr": "sum by (result) (rate(system_s3_sts_requests_total[5m]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "row",
      "title": "Migration between Garage clusters",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Migration in flight",
      "description": "The phase a move to another Garage cluster is in. Empty means there is no move: both series exist only while one runs.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$ds_prometheus"
      },
      "targets": [
        {
          "expr": "system_s3_migration_phase == 1",
          "legendFormat": "{{phase}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Running for",
      "description": "How long the move has been going. Over two hours is D8SystemS3MigrationStalled: a phase that does not advance is usually waiting for room for the second cluster.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$ds_prometheus"
      },
      "targets": [
        {
          "expr": "time() - max(system_s3_migration_started_seconds)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 7200
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Writes frozen",
      "description": "1 while the Cutover phase runs — the only window in which writes to every bucket are refused. Over ten minutes is D8SystemS3WritesFrozen.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$ds_prometheus"
      },
      "targets": [
        {
          "expr": "max(system_s3_migration_phase{phase=\"Cutover\"}) or vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Previous cluster still kept",
      "description": "1 while the Draining phase runs: the cluster the store left is kept read-only for a day as the way back, and takes up space for all of it.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$ds_prometheus"
      },
      "targets": [
        {
          "expr": "max(system_s3_migration_phase{phase=\"Draining\"}) or vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "blue",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "type": "state-timeline",
      "title": "Migration phases over time",
      "description": "One series per phase, with a 1 on the phase the move is in. The order is Provisioning, Copying, Verifying, Cutover, Draining, Decommission, Converged.",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$ds_prometheus"
      },
      "targets": [
        {
          "expr": "system_s3_migration_phase",
          "legendFormat": "{{phase}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 70,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "sds",
    "system-s3",
    "storage"
  ],
  "templating": {
    "list": [
      {
        "current": {
          "selected": false,
